{
  "name": "baderna",
  "productName": "Baderna",
  "version": "0.6.8",
  "description": "Baderna: voz e tela P2P entre amigos",
  "main": "main.js",
  "private": true,
  "repository": "github:HatsuStark/baderna",
  "scripts": {
    "start": "electron .",
    "start:2": "electron . --profile=2",
    "build:native": "native\\build.cmd",
    "dist": "npm run build:native && electron-builder --win",
    "release": "npm run build:native && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.baderna.app",
    "productName": "Baderna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray-muted.png",
      "tmdb-key.txt",
      "turn.json",
      "node_modules/peerjs/dist/peerjs.min.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/proc-audio.exe",
        "to": "proc-audio.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "HatsuStark",
        "repo": "baderna",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Baderna",
      "artifactName": "Baderna-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
